@model IReadOnlyList<CategoryReadDTO>
@{
    ViewData["Title"] = "Категорії";
}

<h1>Категорії</h1>

@if (Model.Count == 0)
{
    <p class="empty">Категорій поки немає.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th>Назва</th>
                <th>Slug</th>
                <th>Батьківська</th>
                <th>Активна</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Id</td>
                    <td>@category.Name</td>
                    <td>@category.Slug</td>
                    <td>@(category.ParentId?.ToString() ?? "—")</td>
                    <td>@(category.IsActive ? "Так" : "Ні")</td>
                </tr>
            }
        </tbody>
    </table>
}
